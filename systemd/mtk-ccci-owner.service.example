[Unit]
Description=MediaTek CCCI modem userspace owner
After=local-fs.target
Before=ModemManager.service
ConditionPathExists=/dev/ccci_monitor

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/default/mtk-ccci
ExecStart=/usr/libexec/mtk-ccci/mdinit.py
Restart=no
NoNewPrivileges=no
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/run/mtk-ccci /var/lib/mtk-ccci

[Install]
WantedBy=multi-user.target
