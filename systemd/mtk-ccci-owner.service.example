[Unit]
Description=MediaTek CCCI modem userspace owner
After=local-fs.target
Before=ModemManager.service
ConditionPathExists=/dev/ccci_monitor

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/default/mtk-ccci
ExecStart=/usr/bin/python3 /usr/libexec/mtk-ccci/start_owner.py
Restart=no
UMask=0077
RuntimeDirectory=mtk-ccci
RuntimeDirectoryMode=0700
StateDirectory=mtk-ccci
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/run/mtk-ccci /var/lib/mtk-ccci

[Install]
WantedBy=multi-user.target
