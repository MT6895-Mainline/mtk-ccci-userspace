# Copy to /etc/default/mtk-ccci on the yuechu (qqcandy) board.
MTK_CCCI_BOARD=qqcandy
# Pins: /proc/sys/kernel/osrelease and sha256 of /sys/kernel/notes.
MTK_CCCI_EXPECTED_KERNEL=7.2.10+
MTK_CCCI_EXPECTED_NOTES_SHA256=ad1b750f15569f9dd1df8b3f3b81d313ebfe7efd18ff4410a7422d6a96b95ca0
MTK_CCCI_VENDOR_ROOT=/mnt/vendor
MTK_CCCI_VENDOR_ETC_ROOT=/vendor
MTK_CCCI_PRIVATE_ROOT=/var/lib/mtk-ccci/private
MDINIT_OVERLAY_ROOT=/var/lib/mtk-ccci/overlay
CCCI_EVIDENCE_DIR=/run/mtk-ccci/evidence
MTK_CCCI_PROPERTY_TABLE=/etc/mtk-ccci/md_sys_props.conf
MTK_CCCI_ENABLE_MDLOG=0
